// Ansible managed
APT::Periodic::AutocleanInterval "{{ unattended_upgrades_autoclean_interval }}";
APT::Periodic::Download-Upgradeable-Packages "{{ unattended_upgrades_download_upgradeable_packages }}";

Unattended-Upgrade::Automatic-Reboot "{{ unattended_upgrades_reboot | lower }}";
Unattended-Upgrade::Automatic-Reboot-Time "{{ unattended_upgrades_reboot_time }}";

Unattended-Upgrade::Origins-Pattern {
{% for origin in unattended_upgrades_additional_origins %}
        "{{ origin }}";
{% endfor %}
};

Unattended-Upgrade::Remove-Unused-Dependencies "{{ unattended_upgrades_remove_unused_dependencies | lower }}";
